---
import Layout from '../layouts/Layout.astro';
import NEOTracker from '../components/NEOTracker';
import NEOSensitivityPanel from '../components/NEOSensitivityPanel.astro';
---

<Layout title="AstroBis Small-Body Watch" description="Inspect a coverage-explicit JPL close-approach snapshot, an albedo and distance-uncertainty sensitivity audit, and interstellar visitor context.">
  <section class="page-hero page-hero-neo">
    <div class="hero-chip">JPL SBDB close approaches + interstellar visitors</div>
    <h1>Small-Body And Visitor Watch</h1>
    <p>
      Inspect returned Earth close approaches with their distance and size assumptions visible,
      then compare known hyperbolic visitors such as 1I, 2I, and 3I/ATLAS.
    </p>
  </section>

  <NEOSensitivityPanel />

  <section style="padding:2.2rem 0 0;">
    <NEOTracker client:only="react" />
  </section>
</Layout>
