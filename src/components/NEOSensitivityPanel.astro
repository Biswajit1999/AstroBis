---
import audit from '../../public/data/neo-sensitivity.json';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;
const distance = audit.distanceSensitivity;
const measuredPct = (audit.measurementCoverage.measuredDiameterFraction * 100).toFixed(1);
const boundaryPct = ((distance.nominalBoundarySensitive / distance.nominalClose) * 100).toFixed(1);
const returnedPct = (audit.coverage.returnedFraction * 100).toFixed(1);
const h22 = audit.sizeSensitivity.h22DiameterKm;
const nominalSize = audit.sizeSensitivity.nominalClose;
const robustLarge = nominalSize['measured-large'] + nominalSize['inferred-robust-large'];
const albedoSensitive = nominalSize['albedo-sensitive'];
const robustSmall = nominalSize['measured-small'] + nominalSize['inferred-robust-small'];
---

<section class="neo-audit" aria-labelledby="neo-audit-title">
  <header class="neo-audit__head">
    <div>
      <p class="neo-audit__eyebrow">Reproducible research audit · sensitivity, not hazard</p>
      <h2 id="neo-audit-title">One threshold can hide two different uncertainties.</h2>
      <p class="neo-audit__lede">
        AstroBis now tests its 0.05 AU / 140 m encounter screen against the JPL
        three-sigma distance interval and an explicit geometric-albedo bracket.
        The result is an evidence audit—not a PHA label, impact probability, or
        planetary-defence recommendation.
      </p>
    </div>
    <span class="neo-audit__badge">SENSITIVITY</span>
  </header>

  <dl class="neo-audit__stats">
    <div><dt>Returned coverage</dt><dd>{audit.coverage.returnedRows.toLocaleString()} / {audit.coverage.matchingRows.toLocaleString()}</dd><small>{returnedPct}% chronological prefix</small></div>
    <div><dt>Nominal ≤0.05 AU</dt><dd>{distance.nominalClose.toLocaleString()}</dd><small>{distance.robustClose} remain inside at 3σ max</small></div>
    <div><dt>Boundary-sensitive</dt><dd>{distance.nominalBoundarySensitive.toLocaleString()}</dd><small>{boundaryPct}% of nominal-close rows</small></div>
    <div><dt>Measured diameters</dt><dd>{audit.measurementCoverage.measuredDiameters.toLocaleString()}</dd><small>{measuredPct}% of returned rows</small></div>
  </dl>

  <div class="neo-audit__grid">
    <figure>
      <img
        src={asset('/assets/neo-sensitivity.svg')}
        width="1200"
        height="650"
        loading="lazy"
        alt={`Horizontal bar comparison: ${distance.nominalClose} nominal close approaches, ${distance.robustClose} robust close approaches, and ${distance.nominalBoundarySensitive} nominal-close rows whose three-sigma interval crosses 0.05 AU. The size screen contains ${robustLarge} robust-large, ${albedoSensitive} albedo-sensitive, and ${robustSmall} robust-small rows.`}
      />
      <figcaption>
        Direct value labels and the table provide the same evidence without
        relying on colour. The committed figure is regenerated from the bundled
        JPL response.
      </figcaption>
    </figure>

    <div class="neo-audit__interpretation">
      <h3>What changed scientifically</h3>
      <p>
        The original interface converted missing JPL diameters to zero. The new
        parser preserves missingness, uses measured diameters when present, and
        otherwise evaluates the standard H–albedo relation. At H=22, the declared
        albedo range 0.05–0.25 spans <strong>{(h22.albedo025 * 1000).toFixed(0)}–{(h22.albedo005 * 1000).toFixed(0)} m</strong>;
        the familiar 140 m value is the pV=0.14 reference, not a measured size.
      </p>
      <p>
        The source query asks for dates through 2050, but its 7,500-row limit and
        date sort end the committed response at <strong>{audit.coverage.lastReturnedApproach}</strong>.
        AstroBis now exposes that truncation instead of implying complete 2050 coverage.
      </p>
      <div class="neo-audit__links" aria-label="Audit downloads and methods">
        <a href={asset('/data/neo-sensitivity.json')}>Machine-readable audit</a>
        <a href={asset('/data/neo-albedo-sensitivity.csv')}>Albedo grid CSV</a>
        <a href="https://ssd-api.jpl.nasa.gov/doc/cad.html">JPL CAD contract</a>
        <a href="https://cneos.jpl.nasa.gov/about/neo_groups.html">CNEOS PHA definition</a>
      </div>
    </div>
  </div>

  <div class="neo-audit__table-wrap" tabindex="0" aria-label="Albedo sensitivity table, horizontally scrollable if needed">
    <table>
      <caption>Objects at or above 140 m under each assumed albedo</caption>
      <thead><tr><th scope="col">Geometric albedo</th><th scope="col">Nominal-close rows</th><th scope="col">3σ-robust-close rows</th></tr></thead>
      <tbody>
        {audit.sizeSensitivity.albedoGrid.map((row) => (
          <tr><th scope="row">{row.albedo.toFixed(2)}</th><td>{row.nominalCloseAtOrAbove140m}</td><td>{row.robustCloseAtOrAbove140m}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <aside class="neo-audit__boundary" aria-label="Boundary of inference">
    <strong>Boundary of inference</strong>
    <span>Close-approach distance is encounter-specific and is not Earth MOID. Albedo values are sensitivity cases, not object-level posterior probabilities. The response is a row-limited chronological prefix.</span>
  </aside>
</section>

<style>
  .neo-audit{--audit-surface:#0e1730;--audit-surface-2:#121f3d;--audit-line:#2b3b61;--audit-text:#f8fafc;--audit-muted:#c3cee0;--audit-cyan:#67e8f9;max-width:1280px;margin:0 auto;padding:clamp(2rem,5vw,4.5rem) 1.25rem;color:var(--audit-text)}
  .neo-audit__head{display:flex;align-items:flex-start;justify-content:space-between;gap:2rem;margin-bottom:2rem}.neo-audit__head>div{max-width:820px}.neo-audit__eyebrow{margin:0 0 .6rem;color:var(--audit-cyan);font-size:.78rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.neo-audit h2{margin:0;font-size:clamp(2rem,5vw,3.5rem);line-height:1.05;letter-spacing:-.035em;text-wrap:balance}.neo-audit__lede{max-width:72ch;margin:1rem 0 0;color:var(--audit-muted);font-size:1.05rem;line-height:1.7}.neo-audit__badge{flex:none;border:1px solid rgba(103,232,249,.45);border-radius:999px;padding:.55rem .8rem;color:var(--audit-cyan);background:rgba(103,232,249,.08);font-size:.75rem;font-weight:850;letter-spacing:.12em}
  .neo-audit__stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin:0 0 1.5rem;overflow:hidden;border:1px solid var(--audit-line);border-radius:18px;background:var(--audit-line)}.neo-audit__stats div{min-width:0;padding:1.2rem;background:var(--audit-surface)}.neo-audit__stats dt{color:var(--audit-muted);font-size:.78rem;font-weight:750;text-transform:uppercase;letter-spacing:.08em}.neo-audit__stats dd{margin:.35rem 0 0;font-size:clamp(1.45rem,3vw,2.3rem);font-weight:850;font-variant-numeric:tabular-nums}.neo-audit__stats small{display:block;margin-top:.35rem;color:var(--audit-muted);line-height:1.45}
  .neo-audit__grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:1.5rem}.neo-audit figure,.neo-audit__interpretation,.neo-audit__table-wrap{margin:0;border:1px solid var(--audit-line);border-radius:18px;background:var(--audit-surface);overflow:hidden}.neo-audit figure img{display:block;width:100%;height:auto;aspect-ratio:1200/650}.neo-audit figcaption{padding:1rem 1.2rem;color:var(--audit-muted);font-size:.9rem;line-height:1.6;border-top:1px solid var(--audit-line)}.neo-audit__interpretation{padding:clamp(1.25rem,3vw,2rem)}.neo-audit__interpretation h3{margin:0 0 1rem;font-size:1.3rem}.neo-audit__interpretation p{color:var(--audit-muted);line-height:1.68}.neo-audit__interpretation strong{color:var(--audit-text)}
  .neo-audit__links{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin-top:1.25rem}.neo-audit__links a{display:flex;align-items:center;min-height:44px;padding:.65rem .8rem;border:1px solid var(--audit-line);border-radius:10px;color:#bae6fd;background:var(--audit-surface-2);font-size:.86rem;font-weight:750;text-decoration:none}.neo-audit__links a:hover{border-color:var(--audit-cyan)}.neo-audit a:focus-visible{outline:3px solid var(--audit-cyan);outline-offset:3px}
  .neo-audit__table-wrap{margin-top:1.5rem;overflow-x:auto}.neo-audit table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}.neo-audit caption{text-align:left;padding:1rem 1.2rem;color:var(--audit-text);font-weight:800}.neo-audit th,.neo-audit td{padding:.8rem 1.2rem;text-align:left;border-top:1px solid var(--audit-line);white-space:nowrap}.neo-audit thead th{color:var(--audit-muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em}.neo-audit tbody th{color:var(--audit-cyan)}
  .neo-audit__boundary{display:flex;gap:1.25rem;margin-top:1.5rem;padding:1rem 1.2rem;border-left:4px solid #fbbf24;border-radius:0 12px 12px 0;background:rgba(251,191,36,.08);line-height:1.6}.neo-audit__boundary strong{flex:none;color:#fde68a}.neo-audit__boundary span{color:var(--audit-muted)}
  @media(max-width:900px){.neo-audit__stats{grid-template-columns:1fr 1fr}.neo-audit__grid{grid-template-columns:1fr}.neo-audit__head{flex-direction:column;gap:1rem}}
  @media(max-width:520px){.neo-audit__stats{grid-template-columns:1fr}.neo-audit__links{grid-template-columns:1fr}.neo-audit__boundary{flex-direction:column;gap:.35rem}.neo-audit th,.neo-audit td{padding:.75rem}.neo-audit__badge{align-self:flex-start}}
</style>
